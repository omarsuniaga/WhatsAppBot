# Server configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
BOT_NAME=web-bot
DEBUG=false

# Google Calendar sync for confirmed appointments (ADR-002, uni-directional).
# Leave GOOGLE_CALENDAR_ENABLED unset/false to keep appointments dashboard-only.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS_PATH=./secrets/google-calendar-sa.json
GOOGLE_CALENDAR_ID=primary
