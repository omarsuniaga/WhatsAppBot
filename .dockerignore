# ============================================
# .dockerignore — WhatsApp Bot Platform
# Keep the build context minimal and secret-free
# ============================================

# ---- Dependencies (reinstalled inside Docker) ----
node_modules/
web/node_modules/

# ---- Build outputs (rebuilt in Docker) ----
lib/
web/dist/

# ---- Secrets & credentials (NEVER in image) ----
.env
.env.*
!.env.example
*-firebase-adminsdk*.json
serviceAccountKey.json
google-services.json

# ---- Session data (persisted via volume) ----
auth_info/
auth_info_baileys/

# ---- IDE & OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Tests (not needed at runtime) ----
tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
coverage/

# ---- Docker files (don't copy into themselves) ----
Dockerfile
docker-compose*.yml

# ---- Docs, agents, scripts (not needed at runtime) ----
agents/
.agents/
docs/
scripts/
*.md
!data/**

# ---- Git ----
.git/
.gitignore
.claude/

# ---- Nginx config (mounted separately) ----
nginx/

# ---- Misc ----
*.png
*.pdf
*.log
*.txt
