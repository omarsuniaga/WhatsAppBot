# ============================================
# WhatsApp Bot Platform — Environment Config
# ============================================
# SECURITY: Never commit this file with real values.
#            Copy to .env and fill in your secrets.
# ============================================

# ---- App ----
BOT_NAME=web-bot
PORT=3001

# Public URL where the dashboard is accessible
# For VPS: https://yourdomain.com  or  http://YOUR_VPS_IP
FRONTEND_URL=http://localhost

# Admin API Key — generate a strong random string
# Example: openssl rand -hex 32
ADMIN_API_KEY=CHANGE_ME

# ---- AI Providers (at least one recommended) ----
# Groq (preferred, faster): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (fallback): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Firebase ----
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Push Notifications
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVER_KEY=

# Firebase Admin SDK — path to the service account JSON
# This file is mounted as a volume in docker-compose (never baked into image)
FIREBASE_ADMIN_SERVICE_ACCOUNT=./orquestapuntacana-firebase-adminsdk-fbsvc-1adc55a0b0.json
