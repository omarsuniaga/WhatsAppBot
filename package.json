{
  "name": "@bot-wa/bot-wa-baileys",
  "version": "1.1.5",
  "description": "Creacte a bot for whatsapp with baileys library or bot-whatsapp",
  "main": "lib/baileys.js",
  "types": "lib/baileys.d.ts",
  "scripts": {
    "build": "tsc",
    "server": "node lib/server/index.js",
    "server:dev": "ts-node src/server/index.ts",
    "web": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "web:install": "cd web && npm install",
    "dev": "concurrently \"npm run server:dev\" \"npm run web\"",
    "example": "tsc && node -r ts-node/register examples/bot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "create-test-user": "ts-node scripts/create-test-user.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/bot-wa-baileys.git"
  },
  "keywords": [
    "bot",
    "baileys",
    "whatsapp",
    "bot-whatsapp",
    "flow",
    "chatbot",
    "whatsapp"
  ],
  "files": [
    "./lib/**/*"
  ],
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "firebase-admin": "^13.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^181.0.0",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "qr-image": "^3.2.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.7.5",
    "uuid": "^13.0.0"
  },
  "author": "Andres Aya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andresayac/bot-wa-baileys/issues"
  },
  "homepage": "https://github.com/andresayac/bot-wa-baileys#readme",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.8",
    "@types/node-cache": "^4.2.5",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
